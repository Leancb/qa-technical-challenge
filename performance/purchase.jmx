        <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="Vazao HTTP compartilhada" enabled="true">
          <intProp name="calcMode">4</intProp>
          <stringProp name="throughput">${__groovy(def elapsed=(System.currentTimeMillis()-org.apache.jmeter.threads.JMeterContextService.getTestStartTime())/1000; def peak=props.getProperty('profile')=='spike' &amp;&amp; elapsed&gt;=props.getProperty('spike.start'\,'60').toDouble() &amp;&amp; elapsed&lt;props.getProperty('spike.end'\,'180').toDouble(); (peak ? props.getProperty('peak.rps'\,'250') : props.getProperty('rps'\,'1')).toDouble()*60)}</stringProp>
        </ConstantThroughputTimer>
        <hashTree />
