            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (['flight','price','airline','fromPort','toPort'].any { vars.get(it) == 'MISSING' }) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Correlacao de voo ausente'); }</stringProp>
