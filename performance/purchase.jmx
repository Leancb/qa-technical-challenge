<?xml version='1.0' encoding='UTF-8'?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Compra de passagem" enabled="true">
      <stringProp name="TestPlan.comments">Carga e pico via properties; vazão em amostras HTTP, sem recursos estáticos.</stringProp>
